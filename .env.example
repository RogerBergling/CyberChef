# ===========================================================================
# CyberChef deployment configuration
# Copy this file to .env and edit. Never commit .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Container image and host publishing
# ---------------------------------------------------------------------------
# Image tag to run: latest, a version tag such as v11.6.0, or a digest.
IMAGE_TAG=latest

# Address and port published on the Docker host. HAProxy connects here.
# 0.0.0.0 exposes the port on every interface; restrict it with a firewall or
# bind 127.0.0.1 if HAProxy runs directly on this host.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8014

# Port nginx listens on inside the container. Keep 8080 unless you have a
# reason to change it. Must be 1024-65535 because the container is unprivileged.
APP_PORT=8080

# ---------------------------------------------------------------------------
# Application defaults
# ---------------------------------------------------------------------------
# First-visit theme: dark, light, classic, geocities, solarized-dark or
# solarized-light. "light", "white" and "classic" all mean CyberChef Classic.
# A visitor's later choice in CyberChef Options is stored in their browser and
# takes precedence.
APP_THEME=dark

# Browser tab title. Printable ASCII; quotes and backslashes are escaped.
APP_TITLE="CyberChef"

# Local favicon path. Only files shipped inside the image (relative path).
APP_FAVICON=favicon.svg

# Nginx server_name. "_" is the catch-all.
SERVER_NAME=_

# ---------------------------------------------------------------------------
# Reverse proxy / client IPs
# ---------------------------------------------------------------------------
# HAProxy is the only source allowed to set X-Forwarded-For. Comma-separated
# CIDRs. The default is the LAN network where HAProxy runs. Set to an empty
# value to disable real-IP handling.
TRUSTED_PROXY_CIDRS=192.168.0.0/18

# X-Forwarded-For is correct for standard HAProxy `option forwardfor`.
REAL_IP_HEADER=X-Forwarded-For

# ---------------------------------------------------------------------------
# nginx runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=warn
ACCESS_LOG=on
NGINX_WORKER_PROCESSES=2
NGINX_WORKER_CONNECTIONS=1024
KEEPALIVE_TIMEOUT=30s
CLIENT_MAX_BODY_SIZE=1m
GZIP=on
GZIP_COMP_LEVEL=5

# Caching. -1 means "no-cache" (revalidate every time). Values accept nginx
# duration syntax such as 1h, 7d, 1y, or off/max/epoch.
CACHE_HTML=-1
CACHE_ASSETS=-1
CACHE_MEDIA=7d
CACHE_DOWNLOAD=1h

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# The strict default CSP blocks CyberChef's three optional network operations:
# HTTP request, DNS over HTTPS and Show on map. To allow the built-in DNS
# resolvers while keeping everything else blocked, set:
# CSP_CONNECT_SRC="'self' blob: https://dns.google.com https://cloudflare-dns.com"
#
# To allow the map operation, add the Wikimedia tile host to CSP_IMG_SRC.
# Allowing arbitrary HTTP requests is equivalent to allowing data exfiltration:
# CSP_CONNECT_SRC="'self' blob: https:"
#
# CSP_SCRIPT_SRC is generated at image build: 'self', 'wasm-unsafe-eval' and
# the hashes of CyberChef's inline bootstrap scripts. Override only if you
# know what you are doing; omitting the hashes stops CyberChef from booting.
CSP_DEFAULT_SRC="'self'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: blob:"
CSP_FONT_SRC="'self' data:"
CSP_CONNECT_SRC="'self' blob:"
CSP_MEDIA_SRC="'self' data: blob:"
CSP_WORKER_SRC="'self' blob:"
CSP_CHILD_SRC="'self' blob:"
CSP_FRAME_SRC="'none'"
CSP_OBJECT_SRC="'none'"
CSP_BASE_URI="'none'"
CSP_FORM_ACTION="'none'"
CSP_FRAME_ANCESTORS="'none'"
CSP_MANIFEST_SRC="'self'"
# CSP_SCRIPT_SRC=

# Permissions-Policy. Clipboard and fullscreen are intentionally left at their
# default self allowlist because CyberChef can use them.
PERMISSIONS_POLICY="accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"

# ---------------------------------------------------------------------------
# Branding palette (Roger's control-room theme)
# ---------------------------------------------------------------------------
BRAND_BG="#070b14"
BRAND_BG_SOFT="#0a1020"
BRAND_BG_ELEV="#0d1526"
BRAND_LINE="rgba(148, 163, 184, 0.18)"
BRAND_LINE_STRONG="rgba(148, 163, 184, 0.34)"
BRAND_TEXT="#e7eefb"
BRAND_TEXT_SOFT="#c2cee2"
BRAND_MUTED="#93a3bb"
BRAND_ACCENT="#38bdf8"
BRAND_ACCENT_2="#a78bfa"
BRAND_OK="#34d399"
BRAND_WARN="#fbbf24"
BRAND_DANGER="#f87171"
